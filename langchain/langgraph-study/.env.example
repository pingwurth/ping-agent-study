# 阿里云百炼 API Key
# 获取方式：https://help.aliyun.com/zh/model-studio/developer-reference/get-api-key
OPENAI_API_KEY=

# API 端点（OpenAI 兼容模式）
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称（可选择不同的模型）
# 可用模型：qwen-turbo, qwen-plus, qwen-max, qwen-long 等
MODEL_NAME=qwen3.6-plus


# LangSmith 配置
LANGSMITH_TRACING="true"
LANGSMITH_API_KEY=""